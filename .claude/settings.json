{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(npx astro --version)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e:*)",
      "Bash(npm run theme)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --show-current)",
      "Bash(git config user.email)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(npm run db:push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase db push:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Bash(git config --global:*)",
      "Bash(git config user.email *)",
      "Bash(git push --force:*)"
    ]
  }
}
