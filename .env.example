# Charging planner settings (technical note §7.1, DEC-60). Names only: copy to
# .env and fill in. Never commit .env. Nothing here is PUBLIC_.

# Supabase project URL (server only)
GM_SUPABASE_URL=
# Service role key. Secret
GM_SUPABASE_SERVICE_KEY=
# Base URL of the LibreBooking stand-in, later the real API.
# Stand-in: <site>/demos/charging-planner/stand-in/api
GM_LIBREBOOKING_URL=
# Shared secret pg_cron sends to the forecast job. Secret
GM_FORECAST_JOB_SECRET=
# Tester console key. Secret
GM_STANDIN_CONSOLE_KEY=
# true: the clock reads the demo clock
GM_DEMO_MODE=
# true: nothing saved, console off, demo notice shown
GM_PUBLIC_DEMO=
# Charging rules link (AC-16.1, AC-16.2)
GM_HANDBOOK_URL=

# Public demo on Vercel Production (see src/planner/README.md):
#   GM_PUBLIC_DEMO=true
#   GM_DEMO_MODE=true
#   GM_SUPABASE_URL / GM_SUPABASE_SERVICE_KEY = the demo project's, not the development project's
#   GM_LIBREBOOKING_URL = https://<production site>/demos/charging-planner/stand-in/api
#   GM_STANDIN_CONSOLE_KEY and GM_FORECAST_JOB_SECRET = not set
# Node 22.12 or later. Preview deployments keep Vercel's deployment protection.
