---
// SCR-08 Swap the battery in a bike (REQ-07, NFR-01). The first battery on
// the shelf is chosen already, so a swap is: open the bike, tap Swap battery,
// tap Save swap. A quarantined battery leads to C14 first (REQ-11).
export const prerender = false;
import { batteryOptions, checkFit, quarantineFault, saveFitting } from '../../../../../../../planner/fleet/fitting.ts';
import { currentBattery } from '../../../../../../../planner/fleet/derive.ts';
import { localInputValue, SAVED } from '../../../../../../../planner/fleet/wording.ts';
import type { Entry } from '../../../../../../../planner/fleet/types.ts';
import { formValues, type Values } from '../../../../../../../planner/forms/validate.ts';
import { fleet } from '../../../../../../../planner/server.ts';
import FittedFrom from '../../../../../../../planner/ui/fleet/FittedFrom.astro';
import Picker from '../../../../../../../planner/ui/fleet/Picker.astro';
import QuarantineConfirm from '../../../../../../../planner/ui/fleet/QuarantineConfirm.astro';
import FormShell from '../../../../../../../planner/ui/forms/FormShell.astro';
import PlannerLayout from '../../../../../../../planner/ui/PlannerLayout.astro';
import { routes } from '../../../../../../../planner/ui/routes.ts';
import { clockFor, pickedName } from '../../../../../../../planner/web/request.ts';
import { save, type SaveOutcome } from '../../../../../../../planner/web/save.ts';

const tag = Astro.params.tag ?? '';
const repo = fleet();
const now = await clockFor(Astro.cookies).now();
const [bike, bikes, batteries, fittings, openFaults] = await Promise.all([
	repo.getBike(tag), repo.listBikes(), repo.listBatteries(), repo.listFittings(), repo.listOpenFaults(),
]);
if (!bike) return new Response(null, { status: 404 });

const fittedNow = currentBattery(tag, fittings);
const options = batteryOptions(batteries, fittings, openFaults, tag);
const firstOnShelf = options.find((o) => o.note === 'On the shelf') ?? options[0];
let values: Values = { battery: firstOnShelf?.value ?? '', fittedFrom: localInputValue(now) };
let errors: Record<string, string> = {};
let outcome: SaveOutcome | null = null;
let warning: { battery: string; fault: Entry } | null = null;

if (Astro.request.method === 'POST') {
	values = formValues(await Astro.request.formData());
	const checked = checkFit(values, { now, bike: tag, bikes, batteries });
	const fault = checked.ok ? quarantineFault(checked.value.battery, openFaults) : null;
	if (checked.ok && fault && values.confirm !== 'fit-anyway') {
		warning = { battery: checked.value.battery, fault };
	} else {
		outcome = await save(Astro, values, {
			check: () => checked,
			write: (v, name) => saveFitting(repo, { battery: v.battery, bike: tag, fittedFrom: v.fittedFrom }, name, now),
			saved: (v) => SAVED.swap(tag, v.battery, fittedNow),
			redirectTo: () => routes.bike(tag),
		});
		if (outcome.kind === 'redirect') return outcome.response;
		if (outcome.kind === 'invalid') errors = outcome.errors;
	}
}
const page = warning ? `${warning.battery} is quarantined` : `Swap the battery in ${tag}`;
---
<PlannerLayout page={page} hasErrors={Object.keys(errors).length > 0}>
	{warning ? (
		<QuarantineConfirm battery={warning.battery} bike={tag} fault={warning.fault} action={Astro.url.pathname} carry={{ battery: values.battery, fittedFrom: values.fittedFrom }} back={routes.swap(tag)} />
	) : (
		<FormShell back={{ href: routes.bike(tag), label: tag }} action={Astro.url.pathname} values={values} errors={errors} order={['battery', 'fittedFrom']} outcome={outcome} submitLabel="Save swap" name={pickedName(Astro.cookies)}>
			<fieldset>
				<legend><h1 class="h4 m-0">Swap the battery in <span class="gm-mono">{tag}</span></h1></legend>
				<p class="gm-muted">{fittedNow ? <>Fitted now: <span class="gm-mono">{fittedNow}</span>. It goes on the shelf.</> : 'No battery fitted now.'}</p>
				<Picker name="battery" options={options} selected={values.battery ?? null} error={errors.battery} />
			</fieldset>
			<FittedFrom value={values.fittedFrom ?? localInputValue(now)} max={localInputValue(now)} error={errors.fittedFrom} />
		</FormShell>
	)}
</PlannerLayout>
