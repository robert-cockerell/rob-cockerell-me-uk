---
// SCR-04 Fleet list, batteries with their locations (REQ-08, AC-08.5, DEC-43).
export const prerender = false;
import { batteryLocations } from '../../../../../planner/fleet/records.ts';
import { fleet } from '../../../../../planner/server.ts';
import FleetList from '../../../../../planner/ui/fleet/FleetList.astro';
import PlannerLayout from '../../../../../planner/ui/PlannerLayout.astro';
import { takeNotice } from '../../../../../planner/web/request.ts';

const notice = takeNotice(Astro.cookies);
const batteries = await batteryLocations(fleet());
---
<PlannerLayout page="Batteries" notice={notice}>
	<FleetList view={{ kind: 'batteries', batteries }} />
</PlannerLayout>
