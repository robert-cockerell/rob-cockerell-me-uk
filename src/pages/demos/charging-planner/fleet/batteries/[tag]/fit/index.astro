---
// SCR-08 Fit a battery to a bike, from the battery's end (REQ-07 AC-07.2,
// REQ-11). The battery record posts here; this page shows the form again only
// after a failed check, and the quarantine warning (C14) before saving.
export const prerender = false;
import { bikeOptions, checkFit, quarantineFault, saveFitting } from '../../../../../../../planner/fleet/fitting.ts';
import { currentBattery } from '../../../../../../../planner/fleet/derive.ts';
import { localInputValue, SAVED } from '../../../../../../../planner/fleet/wording.ts';
import type { Entry } from '../../../../../../../planner/fleet/types.ts';
import { formValues, type Values } from '../../../../../../../planner/forms/validate.ts';
import { fleet } from '../../../../../../../planner/server.ts';
import FitFields from '../../../../../../../planner/ui/fleet/FitFields.astro';
import QuarantineConfirm from '../../../../../../../planner/ui/fleet/QuarantineConfirm.astro';
import FormShell from '../../../../../../../planner/ui/forms/FormShell.astro';
import PlannerLayout from '../../../../../../../planner/ui/PlannerLayout.astro';
import { routes } from '../../../../../../../planner/ui/routes.ts';
import { clockFor, pickedName } from '../../../../../../../planner/web/request.ts';
import { save, type SaveOutcome } from '../../../../../../../planner/web/save.ts';

const tag = Astro.params.tag ?? '';
const repo = fleet();
const now = await clockFor(Astro.cookies).now();
const [battery, bikes, batteries, fittings, openFaults] = await Promise.all([
	repo.getBattery(tag), repo.listBikes(), repo.listBatteries(), repo.listFittings(), repo.listOpenFaults(),
]);
if (!battery) return new Response(null, { status: 404 });

let values: Values = { fittedFrom: localInputValue(now) };
let errors: Record<string, string> = {};
let outcome: SaveOutcome | null = null;
let warning: { bike: string; fault: Entry } | null = null;

if (Astro.request.method === 'POST') {
	values = formValues(await Astro.request.formData());
	const checked = checkFit(values, { now, battery: tag, bikes, batteries });
	const fault = checked.ok ? quarantineFault(tag, openFaults) : null;
	if (checked.ok && fault && values.confirm !== 'fit-anyway') {
		warning = { bike: checked.value.bike, fault };
	} else {
		outcome = await save(Astro, values, {
			check: () => checked,
			write: (v, name) => saveFitting(repo, { battery: tag, bike: v.bike, fittedFrom: v.fittedFrom }, name, now),
			saved: (v) => SAVED.swap(v.bike, tag, currentBattery(v.bike, fittings)),
			redirectTo: () => routes.battery(tag),
		});
		if (outcome.kind === 'redirect') return outcome.response;
		if (outcome.kind === 'invalid') errors = outcome.errors;
	}
}
const page = warning ? `${tag} is quarantined` : `Fit ${tag} to a bike`;
---
<PlannerLayout page={page} hasErrors={Object.keys(errors).length > 0}>
	{warning ? (
		<QuarantineConfirm battery={tag} bike={warning.bike} fault={warning.fault} action={Astro.url.pathname} carry={{ bike: values.bike, fittedFrom: values.fittedFrom }} back={routes.battery(tag)} />
	) : (
		<FormShell back={{ href: routes.battery(tag), label: tag }} action={Astro.url.pathname} values={values} errors={errors} order={['bike', 'fittedFrom']} outcome={outcome} submitLabel="Fit battery" name={pickedName(Astro.cookies)}>
			<FitFields battery={tag} options={bikeOptions(bikes, fittings, tag)} selected={values.bike ?? null} fittedFrom={values.fittedFrom ?? localInputValue(now)} max={localInputValue(now)} errors={errors} headingLevel={1} />
		</FormShell>
	)}
</PlannerLayout>
