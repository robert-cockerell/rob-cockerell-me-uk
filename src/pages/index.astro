---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<Font cssVariable="--font-instrument-sans" preload />
		<Font cssVariable="--font-source-serif" preload />
		<Font cssVariable="--font-plex-mono" />
	</head>
	<body>
		<main class="home">
			<section class="intro">
				<h1>Rob Cockerell</h1>
				<div class="intro-body">
					<p>
						Since I started out in technology, what's held my attention isn't the
						technology so much as the difference it makes — to the lived lives of
						the people using it, and to the organisations it serves.
					</p>
				</div>
			</section>

			<section class="writing">
				<h2 class="section-title"><a href="/blog">Beginning where we are</a></h2>
			</section>

			<section class="shelf">
				<h2 class="section-title">What I'm reading</h2>
				<div class="rail">
					<article class="book">
						<div class="cover"></div>
						<div class="book-text">
							<h3>The Messy Middle</h3>
							<p class="author">Scott Belsky</p>
						</div>
					</article>
					<article class="book">
						<div class="cover"></div>
						<div class="book-text">
							<h3>Software System Development: A Gentle Introduction</h3>
							<p class="author">Britton &amp; Doake</p>
						</div>
					</article>
				</div>
			</section>
		</main>

		<style is:global>
			/* Homepage only. Tokens are prefixed --hp- so they can't collide with
			   the blog's own variables in global.css. */
			:root {
				--hp-paper: #fafbfa;
				--hp-ink: #18211e;
				--hp-muted: #55625d;
				--hp-rule: #dce2de;
				--hp-accent: #2e5a87;
				--hp-accent-soft: #e7eef6;
			}
			body {
				background: var(--hp-paper);
				color: var(--hp-ink);
				font-family: var(--font-source-serif);
				font-size: 1.0625rem;
				line-height: 1.65;
				-webkit-font-smoothing: antialiased;
			}
		</style>

		<style>
			.home {
				width: auto;
				max-width: 1160px;
				margin: 0 auto;
				padding-left: max(16px, env(safe-area-inset-left, 0px));
				padding-right: max(16px, env(safe-area-inset-right, 0px));
				padding-block: clamp(32px, 6vw, 64px) clamp(48px, 8vw, 80px);
				display: grid;
				gap: clamp(40px, 7vw, 68px);
			}

			/* One shared style for every section heading, rule included. */
			.section-title {
				font-family: var(--font-instrument-sans);
				font-weight: 700;
				font-size: clamp(1.6rem, 4.4vw, 2.1rem);
				line-height: 1.06;
				letter-spacing: -0.02em;
				color: var(--hp-ink);
				margin: 0;
				padding-bottom: 18px;
				border-bottom: 1px solid var(--hp-rule);
				text-wrap: balance;
			}
			.section-title a {
				color: inherit;
				text-decoration: none;
			}
			.section-title a:hover {
				color: var(--hp-accent);
			}

			/* The intro: the one tinted block on the page. */
			.intro {
				background: var(--hp-accent-soft);
				border-radius: 14px;
				padding: clamp(24px, 5vw, 40px);
				display: grid;
				grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
				gap: clamp(18px, 4vw, 44px);
				align-items: start;
			}
			.intro h1 {
				font-family: var(--font-instrument-sans);
				font-weight: 700;
				font-size: clamp(1.6rem, 4.4vw, 2.1rem);
				line-height: 1.06;
				letter-spacing: -0.02em;
				color: var(--hp-ink);
				margin: 0;
				text-wrap: balance;
			}
			.intro-body {
				min-width: 0;
				max-width: 64ch;
			}
			.intro-body p {
				margin: 0;
				font-size: 1.15rem;
				line-height: 1.55;
			}

			.writing {
				display: grid;
			}

			/* The reading shelf. Cards widen to full width once the notes are in. */
			.shelf {
				display: grid;
				gap: 22px;
			}
			.rail {
				display: flex;
				gap: 16px;
				overflow-x: auto;
				padding-bottom: 8px;
				scroll-snap-type: x proximity;
				-webkit-overflow-scrolling: touch;
			}
			.book {
				flex: 0 0 min(100%, 20rem);
				min-width: 0;
				scroll-snap-align: start;
				display: grid;
				grid-template-columns: 6rem minmax(0, 1fr);
				gap: 16px;
				align-items: start;
				border: 1px solid var(--hp-rule);
				border-radius: 12px;
				padding: 18px;
			}
			.cover {
				aspect-ratio: 2 / 3;
				max-width: 100%;
				border: 1px solid var(--hp-rule);
				border-radius: 6px;
				background: var(--hp-accent-soft);
			}
			.book-text {
				display: grid;
				gap: 6px;
				min-width: 0;
			}
			.book-text h3 {
				font-family: var(--font-instrument-sans);
				font-weight: 700;
				font-size: 1.05rem;
				line-height: 1.2;
				letter-spacing: -0.01em;
				color: var(--hp-ink);
				margin: 0;
				text-wrap: balance;
			}
			.book-text .author {
				font-family: var(--font-plex-mono);
				font-size: 0.75rem;
				color: var(--hp-muted);
				letter-spacing: 0.04em;
				margin: 0;
			}

			a:focus-visible {
				outline: 3px solid var(--hp-accent);
				outline-offset: 2px;
			}

			@media (max-width: 36rem) {
				.intro {
					grid-template-columns: minmax(0, 1fr);
					gap: 16px;
				}
			}
		</style>
	</body>
</html>
