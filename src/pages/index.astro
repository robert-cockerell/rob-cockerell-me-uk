---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Rob.</h1>
			<p>
				I'm a product manager based in Oxford, UK. This is where I write about the parts of the
				job I find genuinely interesting — stakeholder management, workshop facilitation, and
				turning fuzzy requirements into something a team can build — along with whatever I'm
				building on the side.
			</p>
			<p>
				I'm using this site as a low-stakes way to think in public: short posts, work in
				progress, no pressure for any of it to be a masterpiece.
			</p>
			<p>
				Start with the <a href="/about/">about page</a> for more on who I am, or head to the
				<a href="/blog/">blog</a> for the posts themselves.
			</p>
		</main>
		<Footer />
	</body>
</html>
