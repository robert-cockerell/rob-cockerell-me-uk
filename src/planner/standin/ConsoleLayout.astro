---
// The tester console's own layout: test equipment, not the planner. It imports
// nothing from the blog or the planner's theme.
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		font-family: system-ui, sans-serif;
		line-height: 1.4;
	}
	body {
		margin: 0;
		padding: 1rem;
	}
	main {
		max-width: 72rem;
		margin: 0 auto;
	}
	h1 {
		font-size: 1.5rem;
	}
	h2 {
		font-size: 1.15rem;
		margin-top: 2rem;
		border-top: 1px solid currentColor;
		padding-top: 1rem;
	}
	table {
		border-collapse: collapse;
		width: 100%;
		font-size: 0.9rem;
	}
	th,
	td {
		border: 1px solid #8888;
		padding: 0.25rem 0.5rem;
		text-align: left;
		vertical-align: top;
	}
	form.inline {
		display: inline;
	}
	fieldset {
		border: 1px solid #8888;
		margin: 0.5rem 0;
	}
	label {
		margin-right: 0.75rem;
	}
	button,
	input,
	select {
		font: inherit;
		min-height: 2rem;
	}
	.notice {
		border: 2px solid currentColor;
		padding: 0.5rem 1rem;
	}
	.refused {
		border-style: dashed;
	}
	code,
	.mono {
		font-family: ui-monospace, monospace;
	}
</style>
