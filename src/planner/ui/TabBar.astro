---
// C01 bottom tab bar (design/reference.html #c01) at every width; from 992 px
// the styles make it a dock: centred, the width of the content (DEC-77).
import { routes } from './routes.ts';

interface Props {
	current: 'day-plan' | 'fleet' | null;
}
const { current } = Astro.props;
---
<nav class="gm-tabbar" aria-label="Main">
	<a class="gm-tab" href={routes.dayPlan} aria-current={current === 'day-plan' ? 'page' : undefined}><svg class="gm-icon" aria-hidden="true"><use href="#i-calendar-days"/></svg>Day plan</a>
	<a class="gm-tab" href={routes.fleet} aria-current={current === 'fleet' ? 'page' : undefined}><svg class="gm-icon" aria-hidden="true"><use href="#i-bike"/></svg>Fleet</a>
</nav>
