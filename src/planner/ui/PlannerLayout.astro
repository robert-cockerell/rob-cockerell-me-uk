---
// The planner's own layout (technical note §3). Loads brand/tokens.css, then
// the compiled theme, and nothing from the blog. Fonts come from Astro's Fonts
// API (DEC-51).
import { Font } from 'astro:assets';
import '../../../brand/tokens.css';
import '../../../design/planner-theme.scss';
import { settings } from '../server.ts';
import { pickedName, type Notice as NoticeData } from '../web/request.ts';
import Header from './Header.astro';
import Icons from './Icons.astro';
import Notice from './Notice.astro';
import { routes } from './routes.ts';
import TabBar from './TabBar.astro';

interface Props {
	/** Page name; the title becomes "<page> – Charging planner" (UI spec §8.3). */
	page: string;
	current?: 'day-plan' | 'fleet';
	/** A failed save: the title starts "Error: " (UI spec §5.4). */
	hasErrors?: boolean;
	notice?: NoticeData | null;
}

const { page, current = 'fleet', hasErrors = false, notice = null } = Astro.props;
const name = pickedName(Astro.cookies);
---
<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{hasErrors ? 'Error: ' : ''}{page} – Charging planner</title>
		<link rel="icon" type="image/svg+xml" href={routes.favicon} />
		<Font cssVariable="--font-lexend" preload />
		<Font cssVariable="--font-atkinson-hyperlegible" preload />
		<Font cssVariable="--font-plex-mono" />
		<style is:global>
			/* tokens.css reads --font-atkinson; on planner pages that's Atkinson Hyperlegible. */
			:root { --font-atkinson: var(--font-atkinson-hyperlegible); }
		</style>
	</head>
	<body class="gm-planner">
		<a class="gm-skip" href="#main">Skip to main content</a>
		<Icons />
		<Header current={current} name={name} returnTo={Astro.url.pathname} />
		<main class="gm-main" id="main">
			{settings.publicDemo && (
				<Notice notice={{ kind: 'demo', title: 'This is a demo', body: "Greener Miles is a made-up e-bike library. You can try everything, but changes aren't saved. " }}>
					<a href={routes.demoClock}>Change the demo date and time</a>
				</Notice>
			)}
			<Notice notice={notice} />
			<slot />
		</main>
		<TabBar current={current} />
	</body>
</html>
