---
// The planner's own layout (technical note §3). Loads brand/tokens.css, then
// the compiled theme, and nothing from the blog. Fonts come from Astro's Fonts
// API (DEC-51).
import { Font } from 'astro:assets';
import '../../../brand/tokens.css';
import '../../../design/planner-theme.scss';
import { settings } from '../server.ts';
import { pickedName, type Notice as NoticeData } from '../web/request.ts';
import Header from './Header.astro';
import Icons from './Icons.astro';
import Notice from './Notice.astro';
import { routes } from './routes.ts';
import TabBar from './TabBar.astro';

interface Props {
	/** Page name; the title becomes "<page> – Charging planner" (UI spec §8.3). */
	page: string;
	/** Which tab is current; null on pages that belong to neither (the name picker). */
	current?: 'day-plan' | 'fleet' | null;
	/** A failed save: the title starts "Error: " (UI spec §5.4). */
	hasErrors?: boolean;
	notice?: NoticeData | null;
	/** The day plan uses the full width (UI spec §3.1). */
	wide?: boolean;
}

const { page, current = 'fleet', hasErrors = false, notice = null, wide = false } = Astro.props;
const name = pickedName(Astro.cookies);
---
<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{settings.publicDemo && <meta name="robots" content="noindex" />}
		<title>{hasErrors ? 'Error: ' : ''}{page} – Charging planner</title>
		<link rel="icon" type="image/svg+xml" href={routes.favicon} />
		<Font cssVariable="--font-lexend" preload />
		<Font cssVariable="--font-atkinson-hyperlegible" preload />
		<Font cssVariable="--font-plex-mono" />
		<style is:global>
			/* tokens.css reads --font-atkinson; on planner pages that's Atkinson Hyperlegible. */
			:root { --font-atkinson: var(--font-atkinson-hyperlegible); }
		</style>
	</head>
	<body class="gm-planner">
		<a class="gm-skip" href="#main">Skip to main content</a>
		<Icons />
		<Header name={name} returnTo={Astro.url.pathname} />
		<main class={wide ? 'gm-main gm-main--wide' : 'gm-main'} id="main">
			{settings.publicDemo && (
				<Notice notice={{ kind: 'demo', title: 'This is a demo', body: "Greener Miles is a made-up e-bike library. You can try everything, but changes aren't saved. " }}>
					<a href={routes.demoClock}>Change the demo date and time</a>
				</Notice>
			)}
			<Notice notice={notice} />
			<slot />
		</main>
		{/* Shown in every mode. On phones it clears the fixed tab bar (56 px); the
		    sticky action bar lives inside <main>, so it never overlaps this. */}
		<footer class="gm-site-footer">
			<p>
				Greener Miles is a fictional e-bike library. This demo is route A of a worked example for
				{/* TODO: replace "/" with the article's final path once it is published. */}
				"<a href="/">Effectively gathering business workflows and information for building systems that work</a>"
				by Robert Cockerell. © 2026 Robert Cockerell.
			</p>
		</footer>
		<TabBar current={current} />
	</body>
</html>

<style>
	.gm-site-footer {
		max-width: 720px;
		margin: 0 auto;
		padding: 1rem 1rem calc(56px + env(safe-area-inset-bottom) + 1.5rem);
		border-top: 1px solid var(--gm-border);
		color: var(--gm-text-muted);
		font-size: var(--gm-text-sm);
	}
	.gm-site-footer p { margin: 0; }
	.gm-site-footer a { color: var(--gm-link); text-decoration: underline; }
	@media (min-width: 992px) {
		.gm-site-footer { padding-bottom: 2rem; }
	}
</style>
