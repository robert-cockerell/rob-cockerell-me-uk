---
// SCR-07 bike fields (C12). DI-007 to DI-013. No status, no delete (AC-06.5).
import type { Values } from '../../forms/validate.ts';
import Field from '../forms/Field.astro';

interface Props {
	values: Values;
	errors: Record<string, string>;
	/** Editing: the asset tag is shown, not changed (schema notes S-2). */
	editing: boolean;
	today: string;
}
const { values: v, errors: e, editing, today } = Astro.props;
---
{editing ? (
	<div class="gm-field"><span class="form-label">Asset tag</span><p class="m-0 gm-mono">{v.bikeAssetTag}</p></div>
) : (
	<Field name="bikeAssetTag" label="Asset tag" hint="For example, M13 or G07" value={v.bikeAssetTag} error={e.bikeAssetTag} width="tag" tag />
)}
<Field name="librebookingResourceId" label="LibreBooking resource ID" hint="The number LibreBooking gives this bike. Lewis can tell you" kind="number-text" value={v.librebookingResourceId} error={e.librebookingResourceId} width="short" mono />
<Field name="make" label="Make" hint="For a donated bike, the brand on the frame, or Unknown" value={v.make} error={e.make} />
<Field name="model" label="Model" value={v.model} error={e.model} />
<Field name="frameSize" label="Frame size" optional hint="Leave blank for one-size bikes" value={v.frameSize} error={e.frameSize} width="short" />
<Field name="bikeSerialNumber" label="Serial number" optional value={v.bikeSerialNumber} error={e.bikeSerialNumber} mono />
<Field name="bikePurchaseDate" label="Purchase date" optional hint="When the library bought it, or received it if donated" kind="date" value={v.bikePurchaseDate} error={e.bikePurchaseDate} width="date" max={today} />
