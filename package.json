{
  "name": "rob-cockerell-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run && npm run test:unit:standin",
    "test:e2e": "playwright test && playwright test -c playwright.public-demo.config.ts",
    "test:unit:standin": "node --test \"src/planner/standin/**/*.node-test.ts\"",
    "demo:seed": "node --env-file-if-exists=.env src/planner/standin/cli/seed.ts",
    "demo:reset":"node --env-file-if-exists=.env src/planner/standin/cli/reset.ts",
    "db:new": "supabase migration new",
    "db:push": "supabase db push --remote",
    "theme": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import --no-source-map design/planner-theme.scss design/planner.css",
    "job:forecast": "node --env-file-if-exists=.env src/planner/forecast/cli.ts",
    "test:screenshots": "npm run theme && playwright test -c playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.22",
    "@date-fns/tz": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "admin-lte": "^4.10.0",
    "astro": "^7.2.2",
    "bootstrap": "^5.3.9",
    "date-fns": "^4.4.0",
    "sharp": "^0.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "sass": "^1.108.2",
    "supabase": "^3.1.0",
    "vitest": "^5.1.0"
  }
}
